# ============ LLM 配置 ============
# paratera MaaS API（OpenAI 兼容）
LLM_BASE_URL=https://llmapi.paratera.com/v1
LLM_API_KEY=sk-your-paratera-key-here

# 主对话模型（reasoning，三层分析）
LLM_MODEL_REASONING=GLM-5.2
# 视觉模型（OCR 截图识别）
LLM_MODEL_VISION=GLM-4V
# Embedding 模型（预留，当前未使用）
LLM_MODEL_EMBEDDING=GLM-Embedding-2

# ============ 搜索配置 ============
# Tavily API（免费 1000 次/月，专为 LLM 设计）
TAVILY_API_KEY=tvly-your-tavily-key-here

# ============ 服务配置 ============
PORT=7860
# 是否开启鉴权（v1 不鉴权，公开访问）
AUTH_ENABLED=false

# ============ 会话配置 ============
# 上诉会话 TTL（秒），默认 1 小时
SESSION_TTL_SECONDS=3600

# ============ LLM 调用参数 ============
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3

# ============ 环境标识 ============
ENV=production
